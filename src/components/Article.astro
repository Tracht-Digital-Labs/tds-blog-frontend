---
/**
 * Full article view, shared by the DE (`/[slug]`) and EN (`/en/[slug]`)
 * routes. Receives an already-localized post (authored or machine-
 * translated, see lib/localizedPost.ts) plus the distinct-slug post list
 * for the related/prev-next strips. All in-blog links are prefixed by the
 * current language so DE and EN stay on their own URL space.
 */
import Layout from "~/layouts/Layout.astro";
import RelatedArticles from "~/components/RelatedArticles.astro";
import ProductSlot from "~/components/ProductSlot.astro";
import TagList from "~/components/TagList.astro";
import AdSlot from "~/components/AdSlot.astro";
import BlockRenderer from "~/components/BlockRenderer.astro";
import ProductEmbed from "~/components/ProductEmbed.astro";
import ArticleContact from "~/components/article/ArticleContact.astro";
import ArticleHeader from "~/components/article/ArticleHeader.astro";
import ArticleNeighbours from "~/components/article/ArticleNeighbours.astro";
import ArticleSection from "~/components/article/ArticleSection.astro";
import ArticleToc from "~/components/article/ArticleToc.astro";
import AuthorBio from "~/components/article/AuthorBio.astro";
import ReaderTools from "~/components/article/ReaderTools.astro";
import { LABELS } from "~/components/article/labels";
import { adsConfig, effectiveAdsMode, blogSnippets } from "~/lib/content-api";
import {
  articleCitations,
  articlePlainText,
  chronologicalNeighbours,
  interestTopics,
  laterUpdateLabel,
  type ArticlePostRef,
} from "~/lib/articleView";
import { blogPostingSchema, breadcrumbSchema, faqPageSchema, organizationSchema } from "~/lib/jsonld";
import { imageHints } from "~/lib/imageCatalog";
import { splitProductShortcodes } from "~/lib/productShortcodes";
import { faqFromSections } from "~/lib/articleFaq";
import { splitSections } from "~/lib/sections";
import { splitBlockSections } from "~/lib/blockSections";
import { authorHref, categoryHref } from "~/lib/nav";
import { categorySlug } from "~/lib/taxonomy";
import { pageTitle, siteConfig } from "~/lib/seo";
import { postDescription } from "~/lib/metaDescription";
import { countWords, fallbackAuthorName, formatPostDate, readingMinutes as minutesFor } from "~/lib/postMeta";
import type { LocalizedPost } from "~/lib/localizedPost";

interface Props {
  localized: LocalizedPost;
  lang: "de" | "en";
  /** One entry per distinct slug, for related + prev/next. */
  posts: ArticlePostRef[];
}

const { localized, lang, posts } = Astro.props;
const { post, bodyHtml, blocks, translated } = localized;
const labels = LABELS[lang];

// Two body formats: a block post carries a parsed `blocks` array (rendered by
// BlockRenderer), a legacy markdown post carries `bodyHtml`.
const isBlocks = blocks != null;
const snippets = isBlocks ? await blogSnippets() : [];

// AdSense: the effective mode for this post (per-post override resolved against
// the global config). `manual` places the AdSlots below; the loader + consent
// gate live in Layout. For block posts the author places ads inline (adsense
// blocks), so the Article-level manual slots only apply to markdown posts.
const ads = await adsConfig();
const adsMode = effectiveAdsMode(post.adsMode, ads);
const showManualAds = adsMode === "manual" && !isBlocks;
const showBlockAds = adsMode !== "off";

const pfx = lang === "en" ? "/en" : "";
const homeHref = `${pfx}/`;
const printHref = `${pfx}/${post.slug}/print`;

// Unified section model for the TOC + collapsible bodies. Both formats split at
// level-2 headings; the body of each is rendered format-appropriately below.
const mdSplit = isBlocks ? { intro: "", sections: [] } : splitSections(bodyHtml);
const blkSplit = isBlocks ? splitBlockSections(blocks) : { intro: [], sections: [] };
const sections = (isBlocks ? blkSplit.sections : mdSplit.sections).map((s) => ({ id: s.id, heading: s.heading }));
// `{{produkt:slug}}` paragraphs become product cards between the prose parts
// (see productShortcodes.ts).
const introParts = splitProductShortcodes(mdSplit.intro);
const sectionParts = mdSplit.sections.map((sec) => ({ ...sec, parts: splitProductShortcodes(sec.html) }));
// The article's own FAQ section, as FAQPage — from the rendered text only.
const faq = isBlocks ? [] : faqFromSections(mdSplit.sections);
const showToc = sections.length >= 2;

const { newer, older } = chronologicalNeighbours(posts, post.slug);

const explicitCover = post.coverHint?.startsWith("http") ? post.coverHint : undefined;
const cover = explicitCover ? imageHints(explicitCover, lang) : undefined;

const plain = articlePlainText(localized);
const wordCount = countWords(plain);
const readingMinutes = minutesFor(wordCount);

const ogImagePath = explicitCover ?? `/og/${lang}/${post.slug}.png`;
const imageUrl = ogImagePath.startsWith("http") ? ogImagePath : new URL(ogImagePath, siteConfig.url).toString();
const postUrl = new URL(`${pfx}/${post.slug}`, siteConfig.url).toString();

// The landingpage's contact form, language-aware (its EN page lives under /en/).
const contactUrl = `https://tracht-digital.de${pfx}/#contact`;

// One resolved description for the head and the graph. JSON-LD that disagrees
// with the rendered meta description is a mismatch Google reports.
const metaDesc = postDescription(post.metaDescription, post.excerpt, lang);

// A real author links to its author page and shows its own name, avatar and
// bio; a post without one (deleted user, legacy content) keeps the byline as
// the studio's, unlinked.
const byline = {
  name: post.author?.name ?? fallbackAuthorName(lang),
  href: post.author ? authorHref(lang, post.author.slug) : null,
  avatarUrl: post.author?.avatarUrl ?? null,
  bio: post.author?.bio ?? labels.bio,
};

// The graph names the same author the page shows.
const jsonLd = [
  blogPostingSchema({
    slug: post.slug,
    title: post.title,
    excerpt: metaDesc,
    body: plain,
    category: post.category,
    publishedAt: post.publishedAt,
    updatedAt: post.updatedAt ?? null,
    lang,
    imageUrl,
    wordCount,
    readingMinutes,
    citations: articleCitations(localized),
    author: post.author
      ? { name: post.author.name, url: byline.href ? new URL(byline.href, siteConfig.url).toString() : null }
      : null,
    tags: post.tags,
  }),
  organizationSchema(),
  breadcrumbSchema([
    { name: "Ratgeber", url: `${siteConfig.url}${homeHref}` },
    { name: post.category, url: new URL(categoryHref(lang, categorySlug(post.category)), siteConfig.url).toString() },
    { name: post.title, url: postUrl },
  ]),
  ...(faq.length > 0 ? [faqPageSchema(faq)] : []),
];
---

<Layout
  title={pageTitle(post.title)}
  description={metaDesc}
  lang={lang}
  ogImage={explicitCover}
  article={{
    publishedTime: post.publishedAt,
    modifiedTime: post.updatedAt,
    author: byline.name,
    section: post.category,
    slug: post.slug,
  }}
  jsonLd={jsonLd}
  sidebar
  focusable
  adsMode={adsMode}
  reader={{ printHref }}
  hasToc={showToc}
>
  <div
    id="reading-progress"
    class="fixed top-0 left-0 right-0 z-50 h-[3px] origin-left scale-x-0 bg-[var(--color-accent)]"
    aria-hidden="true"
  >
  </div>

  <main
    id="main"
    class:list={[
      "article-shell px-5 sm:px-6 md:px-8 py-10 lg:py-12",
      showToc && "has-toc",
    ]}
  >
    {showToc && <ArticleToc sections={sections} labels={labels} />}

    <article class="article-col">
      {/* The reading frame: header + body at a reading measure (~70
          characters), scaled as one by the reader's zoom. Everything after it
          (contact, author, related, prev/next) keeps the normal column. */}
      <div class="article-read">
        <div class="article-zoom">
          <ArticleHeader
            category={post.category}
            title={post.title}
            excerpt={post.excerpt}
            publishedAt={post.publishedAt}
            updatedAt={post.updatedAt}
            dateLabel={formatPostDate(post.publishedAt, lang)}
            updatedLabel={laterUpdateLabel(post.publishedAt, post.updatedAt, lang)}
            readingMinutes={readingMinutes}
            author={byline}
            translated={translated}
            homeHref={homeHref}
            lang={lang}
            labels={labels}
          />
          {explicitCover && (
            <img
              src={explicitCover}
              alt={cover?.alt ?? post.title}
              srcset={cover?.srcSet}
              sizes="(min-width: 64rem) 65vw, 100vw"
              width={cover?.width ?? 1440}
              height={cover?.height ?? 960}
              loading="eager"
              decoding="async"
              class="w-full aspect-[3/2] object-cover mb-7"
            />
          )}
        </div>

        <ReaderTools printHref={printHref} labels={labels} />

        <div class="article-zoom mt-4 pb-10">
          {isBlocks ? (
            blkSplit.intro.length > 0 && (
              <BlockRenderer blocks={blkSplit.intro} ads={ads} showAds={showBlockAds} lang={lang} snippets={snippets} dropCap />
            )
          ) : (
            introParts.map((part, i) =>
              part.kind === "html" ? (
                <div class:list={["tds-prose", i === 0 && "drop-cap"]} set:html={part.html}></div>
              ) : (
                <ProductEmbed slug={part.slug} variant={part.variant} lang={lang} />
              ),
            )
          )}
          {showManualAds && ads.slotInArticle && (
            <AdSlot client={ads.publisherId} slot={ads.slotInArticle} lang={lang} />
          )}
          {isBlocks
            ? blkSplit.sections.map((sec) => (
                <ArticleSection id={sec.id} heading={sec.heading}>
                  <BlockRenderer blocks={sec.blocks} ads={ads} showAds={showBlockAds} lang={lang} snippets={snippets} />
                </ArticleSection>
              ))
            : sectionParts.map((sec) => (
                <ArticleSection id={sec.id} heading={sec.heading}>
                  {sec.parts.map((part) =>
                    part.kind === "html" ? (
                      <div class="tds-prose" set:html={part.html}></div>
                    ) : (
                      <ProductEmbed slug={part.slug} variant={part.variant} lang={lang} />
                    ),
                  )}
                </ArticleSection>
              ))}
          {showManualAds && ads.slotEndArticle && (
            <AdSlot client={ads.publisherId} slot={ads.slotEndArticle} lang={lang} />
          )}
        </div>
      </div>

      {/* The end of the article is one flush stack of panels: contact
          (bordeaux), author (tint), products (sand), related (tint), tags
          (sand), prev/next (tint), links (sand). The 1px seams come from
          .jnl-article-end, and a component with nothing to show renders no
          panel at all. `focus-hide` stays per panel, because reader focus mode
          removes every piece of chrome. */}
      <div class="jnl-article-end">
        <ArticleContact href={contactUrl} labels={labels} />

        <AuthorBio author={byline} fallback={!post.author} lang={lang} labels={labels} />

        {/* Products before the related articles: the reader who has finished
            the piece is at their most interested here, and the related strip
            is the natural end of the page. The class goes on the component,
            not on a wrapper: an empty wrapper would still be a grid item and
            double the seam. */}
        <ProductSlot class="focus-hide" slotKey="blog-article-end" lang={lang} category={post.category} />

        <RelatedArticles
          class="focus-hide"
          posts={posts}
          currentSlug={post.slug}
          currentCategory={post.category}
          lang={lang}
        />

        <TagList class="focus-hide jnl-panel jnl-tone-sand" tags={post.tags} lang={lang} label="Tags" />

        <ArticleNeighbours newer={newer} older={older} pfx={pfx} labels={labels} />

        <footer class="jnl-panel jnl-tone-sand flex flex-wrap items-baseline justify-between gap-4 text-sm">
          <a href={homeHref} class="link-underline text-[var(--color-accent)]">
            ← {labels.allArticles}
          </a>
          <a href={`${pfx}/rss`} class="link-underline text-[var(--color-muted)]">
            {labels.rss}
          </a>
        </footer>
      </div>
    </article>
  </main>

  <script>
    import { mountFocusMode, mountReaderZoom } from "~/lib/readerTools";

    mountFocusMode();
    mountReaderZoom();
  </script>

  <script>
    import { mountArticleNav } from "~/lib/articleNav";

    mountArticleNav();
  </script>

  <script>
    import { mountReadingProgress } from "~/lib/readingProgress";

    mountReadingProgress();
  </script>

  {/* Topics for "Für dich", counted only with the "Komfort" consent —
      see lib/interests.ts. The data rides in an attribute because a
      bundled script cannot take `define:vars`. */}
  <div hidden data-interest-topics={JSON.stringify(interestTopics(post))}></div>
  <script>
    import { trackInterests } from "~/lib/interests";

    const host = document.querySelector<HTMLElement>("[data-interest-topics]");
    try {
      trackInterests(JSON.parse(host?.dataset.interestTopics ?? "[]") as string[]);
    } catch {
      /* malformed topics — recommendations stay generic */
    }
  </script>
</Layout>
